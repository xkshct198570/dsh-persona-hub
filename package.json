{
  "name": "dsh-persona-hub",
  "version": "0.5.4",
  "description": "网页端与各平台机器人各用哪份人设：一处配置、逐层回落；只读本地人设文本、不联网、不写记忆库，另镜像一份配置供 Python 网关直读。关掉后网页端不再注入额外人设、QQ 端回落网关旧逻辑。",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host",
    "lib/client.js",
    "lib/client-src",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "personas"
  ],
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "roleplay"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check.mjs",
    "pretest": "node scripts/i18n-check.mjs --check 1>&2 && node scripts/build-client.mjs --check 1>&2 && node scripts/lint-size.mjs --check 1>&2 && node scripts/compare-baseline.mjs 1>&2",
    "prepack": "node scripts/i18n-check.mjs --check 1>&2 && node scripts/build-client.mjs --check 1>&2",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "lint:size": "node scripts/lint-size.mjs",
    "capture:baseline": "node scripts/capture-baseline.mjs",
    "compare:baseline": "node scripts/compare-baseline.mjs",
    "posttest": "node scripts/check-test-counts.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "author": "大肥鱼",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkshct198570/dsh-persona-hub.git"
  },
  "homepage": "https://github.com/xkshct198570/dsh-persona-hub#readme",
  "bugs": {
    "url": "https://github.com/xkshct198570/dsh-persona-hub/issues"
  },
  "devDependencies": {
    "acorn": "8.14.0"
  }
}
